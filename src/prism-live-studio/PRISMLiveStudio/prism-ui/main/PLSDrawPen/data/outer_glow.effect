uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d imageMask;

uniform float2 tex_size;
uniform int range;
uniform float4 glow_color;

sampler_state def_sampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertInOut {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertInOut VSDefault(VertInOut vert_in)
{
	VertInOut vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = vert_in.uv;
	return vert_out;
}

float4 OuterGlow(VertInOut vert_in, float4 col)
{
	float inner = 0;
    int count = 0;
    int2 baseCoord = int2(vert_in.pos.xy);
    int2 texLimit = int2(tex_size) - int2(1, 1);
    for (int k = -range; k <= range; ++k)
    {
		for (int j = -range; j <= range; ++j)
        {
			int2 sampleCoord = clamp(baseCoord + int2(k, j), int2(0, 0), texLimit);
			float4 m = image.Load(int3(sampleCoord, 0));
			inner += m.a;
			count += 1;
		}
	}
    inner /= count;

    float out_alpha = max(col.a, inner*2);
	out_alpha = min(1, out_alpha);

	if(col.a < 0.9){
		col.rgb = col.rgb + (1-col.a) * 1 * glow_color.a * glow_color.rgb;
		col.a = out_alpha;
	}
    return col;
}

float4 PSOuterFlow(VertInOut vert_in) : TARGET
{
	float4 v_color =  float4(1.0, 1.0, 1.0, 1.0);
    float4 col = image.Sample(def_sampler, vert_in.uv) * v_color;
	if(col.a >= 0.9){
		return col;
	}

	return OuterGlow(vert_in, col);
}

float4 PSOuterFlowWithMask(VertInOut vert_in) : TARGET
{
	float4 v_color =  float4(1.0, 1.0, 1.0, 1.0);
    float4 col = image.Sample(def_sampler, vert_in.uv) * v_color;
	if(col.a >= 0.9){
		return col;
	}

    float4 box = imageMask.Sample(def_sampler, vert_in.uv);
	if (box.a < 0.0001){
		return col;
	}

	return OuterGlow(vert_in, col);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSOuterFlow(vert_in);
	}
}

technique DrawWithMask
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSOuterFlowWithMask(vert_in);
	}
}
